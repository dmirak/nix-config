layout {

    focus-ring {
        active-color   "#61eab8"
        inactive-color "#073625"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#61eab8"
        inactive-color "#073625"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#07362570"
    }

    tab-indicator {
        active-color   "#61eab8"
        inactive-color "#06925f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#61eab880"
    }
}

recent-windows {
    highlight {
        active-color "#61eab8"
        urgent-color "#fd4663"
    }
}
