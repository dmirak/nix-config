layout {

    focus-ring {
        active-color   "#67c7e4"
        inactive-color "#12212b"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67c7e4"
        inactive-color "#12212b"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#12212b70"
    }

    tab-indicator {
        active-color   "#67c7e4"
        inactive-color "#0c6f8d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67c7e480"
    }
}

recent-windows {
    highlight {
        active-color "#67c7e4"
        urgent-color "#fd4663"
    }
}
