layout {

    focus-ring {
        active-color   "#55b7f7"
        inactive-color "#03253a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#55b7f7"
        inactive-color "#03253a"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#03253a70"
    }

    tab-indicator {
        active-color   "#55b7f7"
        inactive-color "#005d9a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#55b7f780"
    }
}

recent-windows {
    highlight {
        active-color "#55b7f7"
        urgent-color "#fd4663"
    }
}
