layout {

    focus-ring {
        active-color   "#cebdff"
        inactive-color "#1b1016"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#cebdff"
        inactive-color "#1b1016"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#cebdff"
        inactive-color "#4e378b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#cebdff80"
    }
}

recent-windows {
    highlight {
        active-color "#cebdff"
        urgent-color "#ffb4ab"
    }
}
