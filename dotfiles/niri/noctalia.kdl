layout {

    focus-ring {
        active-color   "#e47f67"
        inactive-color "#281915"
        urgent-color   "#d69c76"
    }

    border {
        active-color   "#e47f67"
        inactive-color "#281915"
        urgent-color   "#d69c76"
    }

    shadow {
        color "#28191570"
    }

    tab-indicator {
        active-color   "#e47f67"
        inactive-color "#8d240c"
        urgent-color   "#d69c76"
    }

    insert-hint {
        color "#e47f6780"
    }
}

recent-windows {
    highlight {
        active-color "#e47f67"
        urgent-color "#d69c76"
    }
}
