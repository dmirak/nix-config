layout {

    focus-ring {
        active-color   "#5cb8ef"
        inactive-color "#062538"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#5cb8ef"
        inactive-color "#062538"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#06253870"
    }

    tab-indicator {
        active-color   "#5cb8ef"
        inactive-color "#025f96"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#5cb8ef80"
    }
}

recent-windows {
    highlight {
        active-color "#5cb8ef"
        urgent-color "#fd4663"
    }
}
