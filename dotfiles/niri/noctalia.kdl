layout {

    focus-ring {
        active-color   "#6e67e4"
        inactive-color "#161529"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6e67e4"
        inactive-color "#161529"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#16152970"
    }

    tab-indicator {
        active-color   "#6e67e4"
        inactive-color "#130c8d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6e67e480"
    }
}

recent-windows {
    highlight {
        active-color "#6e67e4"
        urgent-color "#fd4663"
    }
}
