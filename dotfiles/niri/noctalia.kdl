layout {

    focus-ring {
        active-color   "#fc8150"
        inactive-color "#291a14"
        urgent-color   "#ca3d04"
    }

    border {
        active-color   "#fc8150"
        inactive-color "#291a14"
        urgent-color   "#ca3d04"
    }

    shadow {
        color "#291a1470"
    }

    tab-indicator {
        active-color   "#fc8150"
        inactive-color "#9a2c00"
        urgent-color   "#ca3d04"
    }

    insert-hint {
        color "#fc815080"
    }
}

recent-windows {
    highlight {
        active-color "#fc8150"
        urgent-color "#ca3d04"
    }
}
