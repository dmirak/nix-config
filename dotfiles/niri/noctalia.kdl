layout {

    focus-ring {
        active-color   "#f85484"
        inactive-color "#29141a"
        urgent-color   "#f51355"
    }

    border {
        active-color   "#f85484"
        inactive-color "#29141a"
        urgent-color   "#f51355"
    }

    shadow {
        color "#29141a70"
    }

    tab-indicator {
        active-color   "#f85484"
        inactive-color "#9a002d"
        urgent-color   "#f51355"
    }

    insert-hint {
        color "#f8548480"
    }
}

recent-windows {
    highlight {
        active-color "#f85484"
        urgent-color "#f51355"
    }
}
