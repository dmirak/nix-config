// The {#3X} colors below map to the color pallete generated by noctalia where color0 = 30, color1 = 31, color2 = 32 and so on
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/nixos-snowflake.png",
    "width": 24,
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "key": {
      "width": 15
    },
    "separator": ""
  },
  "modules": [
    { "type": "custom", "format": "{#31}╭─ System" },
    { "type": "os", "key": "{#31}│  OS" },
    { "type": "kernel", "key": "{#31}│  Kernel" },
    { "type": "board", "key": "{#31}│  Board" },
    { "type": "bios", "key": "{#31}│  BIOS" },
    { "type": "uptime", "key": "{#31}│  Uptime" },
    {
      "type": "command",
      "key": "{#31}│  OS Age",
      "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\""
    },
    { "type": "custom", "format": "{#31}╰─" },

    { "type": "custom", "format": "{#32}╭─ Hardware" },
    {
      "type": "cpu",
      "key": "{#32}│  CPU",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "{#32}│ 󰾲 GPU",
      "temp": true
    },
    { "type": "memory", "key": "{#32}│  Memory" },
    { "type": "disk", "key": "{#32}│  Disk" },
    { "type": "custom", "format": "{#32}╰─" },

    { "type": "custom", "format": "{#33}╭─ Desktop" },
    { "type": "display", "key": "{#33}│ 󰍹 Display" },
    { "type": "wm", "key": "{#33}│  WM" },
    {
      "type": "gpu",
      "key": "{#33}│  Driver",
      "format": "{driver}"
    },
    { "type": "custom", "format": "{#33}╰─" },

    { "type": "custom", "format": "{#36}╭─ Terminal" },
    { "type": "shell", "key": "{#36}│  Shell" },
    { "type": "terminal", "key": "{#36}│  Terminal" },
    { "type": "terminalfont", "key": "{#36}│  Font" },
    { "type": "packages", "key": "{#36}│ 󰏖 Packages" },
    { "type": "custom", "format": "{#36}╰─" },

    { "type": "custom", "format": "{#35}╭─ Development" },
    { "type": "editor", "key": "{#35}│ 󱞎 Editor" },
    {
      "type": "command",
      "key": "{#35}│  Git",
      "text": "git --version | sed 's/git version //'"
    },
    { "type": "custom", "format": "{#35}╰─" }
  ]
}
